# LINE Messaging API 設定
LINE_CHANNEL_SECRET=在此貼上 Channel Secret
LINE_CHANNEL_ACCESS_TOKEN=在此貼上 Channel Access Token

# 你的 LINE 使用者 ID（只有這個 ID 能控制 Mac）
# 取得方式：步驟 4 說明
LINE_AUTHORIZED_USER_ID=在此貼上你的 LINE User ID

# Anthropic API Key
ANTHROPIC_API_KEY=在此貼上 Anthropic API Key

# Server Port（預設 5000）
PORT=5000
