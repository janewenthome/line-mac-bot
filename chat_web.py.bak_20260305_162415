st.caption("向我詢問任何藏在你筆記裡的知識。")
st.divider()

# 顯示歷史對話
for msg in st.session_state.messages:
    with st.chat_message(msg["role"]):
        st.markdown(msg["content"])
        # 顯示來源（只有 assistant 有）
        if msg["role"] == "assistant" and msg.get("sources"):
            with st.expander("📎 參考來源", expanded=False):
                for src in msg["sources"]:
                    st.caption(f"• {src}")

# 輸入框
if user_input := st.chat_input("問我你筆記裡的任何東西..."):

    # 顯示使用者訊息
    with st.chat_message("user"):
        st.markdown(user_input)
    st.session_state.messages.append({
        "role": "user", "content": user_input, "sources": []
    })

    # 搜尋 + 生成
    with st.chat_message("assistant"):
        with st.spinner("🔍 搜尋筆記中..."):
            notes_ctx, sources = search_obsidian(user_input)
        with st.spinner("✍️ 思考中..."):
            reply = answer_with_obsidian(user_input, notes_ctx)

        st.markdown(reply)

        # 來源顯示
        if sources:
            with st.expander("📎 參考來源", expanded=False):
                for src in sources:
                    st.caption(f"• {src}")

    # 存入 session
    st.session_state.messages.append({
        "role": "assistant", "content": reply, "sources": sources
    })
